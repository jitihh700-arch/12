-- ============================================================
-- Fix : Réponses multijoueur partagées et non volables
-- ============================================================
-- Problème : la contrainte d'unicité était sur (game_id, answer_id),
-- ce qui empêchait plusieurs joueurs de trouver la même réponse.
-- Quand un joueur B tapait une réponse déjà trouvée par A,
-- la fonction faisait un UPDATE qui "volait" la réponse à A.
--
-- Solution :
-- 1. Contrainte sur (game_id, player_id, answer_id)
-- 2. submit_multiplayer_answer fait INSERT ... ON CONFLICT DO NOTHING
-- 3. get_my_multiplayer_game_state retourne aussi all_found_answers
-- ============================================================

-- 1. Corriger la contrainte d'unicité pour permettre à plusieurs joueurs
--    de trouver la même réponse chacun de leur côté
ALTER TABLE public.multiplayer_answers
DROP CONSTRAINT IF EXISTS multiplayer_answers_unique_answer;

ALTER TABLE public.multiplayer_answers
ADD CONSTRAINT multiplayer_answers_unique_player_answer
UNIQUE (game_id, player_id, answer_id);

-- 2. Recréer get_my_multiplayer_game_state avec all_found_answers
--    (tableau JSON de TOUTES les réponses trouvées par TOUT le monde)
CREATE OR REPLACE FUNCTION public.get_my_multiplayer_game_state(p_game_code text)
RETURNS TABLE (
  game_code text,
  category_id text,
  status text,
  max_players integer,
  current_players integer,
  host_id uuid,
  duration_seconds integer,
  started_at timestamptz,
  expires_at timestamptz,
  finished_at timestamptz,
  player_id uuid,
  pseudo text,
  score integer,
  correct_answers integer,
  is_ready boolean,
  is_connected boolean,
  is_host boolean,
  user_id uuid,
  rank integer,
  my_found_display_order integer,
  my_found_answer_display text,
  my_found_answer_year text,
  my_found_hint text,
  my_answered_at timestamptz,
  all_found_answers jsonb
)
LANGUAGE sql
SECURITY DEFINER
SET search_path = ''
AS $$
  SELECT
    g.game_code,
    g.category_id,
    g.status,
    g.max_players,
    g.current_players,
    g.host_id,
    g.duration_seconds,
    g.started_at,
    g.expires_at,
    g.finished_at,
    p.id AS player_id,
    pr.pseudo,
    p.score,
    p.correct_answers,
    p.is_ready,
    p.is_connected,
    p.is_host,
    p.user_id,
    p.rank,
    CASE WHEN fa.user_id = auth.uid() THEN fa.display_order END AS my_found_display_order,
    CASE WHEN fa.user_id = auth.uid() THEN a.display END AS my_found_answer_display,
    CASE WHEN fa.user_id = auth.uid() THEN a.answer_year END AS my_found_answer_year,
    CASE WHEN fa.user_id = auth.uid() THEN a.hint END AS my_found_hint,
    CASE WHEN fa.user_id = auth.uid() THEN fa.answered_at END AS my_answered_at,
    (
      SELECT COALESCE(
        JSONB_AGG(
          DISTINCT JSONB_BUILD_OBJECT(
            'displayOrder', all_a.display_order,
            'display', all_a.display,
            'answerYear', all_a.answer_year,
            'hint', all_a.hint
          ) ORDER BY all_a.display_order
        ),
        '[]'::JSONB
      )
      FROM public.multiplayer_answers all_fa
      JOIN private.quiz_answers all_a ON all_a.id = all_fa.answer_id
      WHERE all_fa.game_id = g.id
    ) AS all_found_answers
  FROM public.multiplayer_games AS g
  JOIN public.multiplayer_players AS p ON p.game_id = g.id
  LEFT JOIN public.profiles AS pr ON pr.id = p.user_id
  LEFT JOIN public.multiplayer_answers AS fa ON fa.game_id = g.id AND fa.player_id = p.id
  LEFT JOIN private.quiz_answers AS a ON a.id = fa.answer_id
  WHERE g.game_code = p_game_code
    AND p.left_at IS NULL
  ORDER BY p.is_host DESC, p.joined_at, p.id;
$$;

REVOKE ALL ON FUNCTION public.get_my_multiplayer_game_state(text) FROM public;
GRANT EXECUTE ON FUNCTION public.get_my_multiplayer_game_state(text) TO authenticated;

-- 3. Recréer submit_multiplayer_answer (version sécurisée)
DROP FUNCTION IF EXISTS public.submit_multiplayer_answer(text, text, uuid);

CREATE OR REPLACE FUNCTION public.submit_multiplayer_answer(
  p_game_code text,
  p_answer text,
  p_client_submission_id uuid DEFAULT NULL
)
RETURNS TABLE (
  result text,
  score integer,
  correct_answers integer
)
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = ''
AS $$
DECLARE
  v_user_id uuid;
  v_game_id uuid;
  v_player_id uuid;
  v_player_record public.multiplayer_players%ROWTYPE;
  v_answer_id uuid;
  v_display_order integer;
  v_matched boolean;
BEGIN
  v_user_id := private.assert_multiplayer_profile();

  -- Verrouiller la partie pour éviter les courses
  SELECT id INTO v_game_id
  FROM public.multiplayer_games
  WHERE game_code = p_game_code
    AND status = 'playing'
  FOR UPDATE;

  IF v_game_id IS NULL THEN
    RAISE EXCEPTION 'game_not_found_or_not_playing' USING ERRCODE = 'P0002';
  END IF;

  -- Récupérer le joueur
  SELECT * INTO v_player_record
  FROM public.multiplayer_players
  WHERE game_id = v_game_id
    AND user_id = v_user_id
    AND left_at IS NULL;

  IF v_player_record.id IS NULL THEN
    RAISE EXCEPTION 'not_a_player' USING ERRCODE = '42501';
  END IF;

  v_player_id := v_player_record.id;

  -- Matcher la réponse avec la fonction privée
  SELECT
    ma.id,
    ma.display_order,
    private.match_multiplayer_answer(p_answer, g.category_id, ma.id, ma.display)
  INTO v_answer_id, v_display_order, v_matched
  FROM public.multiplayer_games g
  JOIN private.quiz_answers ma ON ma.category_id = g.category_id
  WHERE g.id = v_game_id
    AND private.match_multiplayer_answer(p_answer, g.category_id, ma.id, ma.display) = true
  LIMIT 1;

  IF NOT v_matched OR v_answer_id IS NULL THEN
    result := 'incorrect';
    score := v_player_record.score;
    correct_answers := v_player_record.correct_answers;
    RETURN NEXT;
    RETURN;
  END IF;

  -- Essayer d'insérer la réponse trouvée par CE joueur.
  -- La contrainte unique (game_id, player_id, answer_id) empêche les doublons.
  -- ON CONFLICT DO NOTHING : si un autre joueur a déjà trouvé cette réponse,
  -- ça ne change RIEN à son entrée. Chaque joueur a sa propre entrée.
  INSERT INTO public.multiplayer_answers (game_id, player_id, user_id, answer_id, display_order, answered_at)
  VALUES (v_game_id, v_player_id, v_user_id, v_answer_id, v_display_order, clock_timestamp())
  ON CONFLICT ON CONSTRAINT multiplayer_answers_unique_player_answer
  DO NOTHING;

  -- Si l'insertion n'a rien fait (déjà trouvée par CE joueur), retourner duplicate
  IF NOT FOUND THEN
    result := 'duplicate';
    score := v_player_record.score;
    correct_answers := v_player_record.correct_answers;
    RETURN NEXT;
    RETURN;
  END IF;

  -- Mettre à jour le score du joueur (incrémenté individuellement)
  UPDATE public.multiplayer_players
  SET correct_answers = correct_answers + 1,
      score = (correct_answers + 1) * 10,
      last_activity_at = clock_timestamp()
  WHERE id = v_player_id
  RETURNING public.multiplayer_players.score, public.multiplayer_players.correct_answers
  INTO score, correct_answers;

  result := 'correct';
  RETURN NEXT;
  RETURN;
END;
$$;

REVOKE ALL ON FUNCTION public.submit_multiplayer_answer(text, text, uuid) FROM public;
GRANT EXECUTE ON FUNCTION public.submit_multiplayer_answer(text, text, uuid) TO authenticated;
